# ---------------------------------------------------------------------------
# Producción con docker-compose.prod.yml. Copiar a .env.production y completar.
# NUNCA subir .env.production al repositorio.
# Generar secretos con:  openssl rand -hex 24   (solo letras y números: seguros dentro de URLs)
# ---------------------------------------------------------------------------
APP_ENV=production
DOMAIN=inspecciones.miempresa.com
APP_URL=https://inspecciones.miempresa.com
APP_TIMEZONE=America/Bogota
NEXT_PUBLIC_APP_TIMEZONE=America/Bogota

# Base de datos (el contenedor postgres se crea con estos datos)
POSTGRES_USER=inspecciones
POSTGRES_PASSWORD=CAMBIAR-por-una-clave-larga
POSTGRES_DB=inspecciones

# Sesiones: secreto de mínimo 32 caracteres
AUTH_SECRET=CAMBIAR-por-un-secreto-largo-y-aleatorio-de-32-o-mas
SESSION_TTL_HOURS=12

# Correo (SMTP de tu proveedor: Microsoft 365, Google Workspace, Amazon SES, SendGrid…)
# Envía las notificaciones (asignaciones, recordatorios, alertas críticas). Si SMTP_HOST
# queda vacío, los avisos solo aparecen en la campana de la app.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@miempresa.com
SMTP_PASSWORD=CAMBIAR
MAIL_FROM="Inspecciones <notificaciones@miempresa.com>"

# Fotos y documentos
#   local → volumen "uploads" del servidor (recomendado para empezar; respaldarlo)
#   s3    → Amazon S3 / Cloudflare R2. En EC2 se recomienda un rol IAM (sin llaves).
STORAGE_DRIVER=local
UPLOAD_MAX_MB=10
# Solo si STORAGE_DRIVER=s3:
# S3_REGION=us-east-2
# S3_BUCKET=inspecciones-miempresa
# S3_ENDPOINT=                      (vacío para AWS; https://<cuenta>.r2.cloudflarestorage.com para R2)
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=                 (vacío en EC2 con rol IAM)
# S3_SECRET_ACCESS_KEY=

# Tareas programadas (vencimientos → hallazgo crítico automático)
INTERNAL_SCHEDULER=true
CRON_SECRET=

# Cuenta general de Super Administrador (única cuenta inicial; se crea solo si no
# existe ningún administrador y debe cambiar la clave en el primer ingreso).
# La instalación no crea usuarios ni datos de prueba.
SEED_ADMIN_EMAIL=superadmin@miempresa.com
SEED_DEFAULT_PASSWORD=CAMBIAR-Clave-Inicial-2026

# Solo con docker-compose.proxy-externo.yml (la empresa ya tiene proxy HTTPS):
# puerto e interfaz donde se publica la aplicación en HTTP para ese proxy.
# APP_PORT=3000
# APP_BIND=0.0.0.0
