# ---------------------------------------------------------------------------
# Copiar a `.env` para desarrollo local. NUNCA commitear `.env` con secretos.
# ---------------------------------------------------------------------------

# development | staging | production (entorno lógico de la app; NODE_ENV lo maneja Next)
APP_ENV=development
# URL pública de la aplicación (se usa en correos, QR y enlaces de recuperación)
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://inspecciones:inspecciones@localhost:5432/inspecciones?schema=public

# Sesiones
SESSION_TTL_HOURS=12
# Secreto para firmar/derivar tokens (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Correo (SMTP). En desarrollo se usa Mailpit (docker compose) → http://localhost:8025
# Si SMTP_HOST está vacío, los correos se escriben en la consola.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Inspecciones <no-reply@inspecciones.local>"

# Almacenamiento de fotografías y documentos
#   s3    → S3-compatible: MinIO en local (docker compose), AWS S3 / Cloudflare R2 en producción
#   local → disco en LOCAL_STORAGE_DIR (solo desarrollo sin Docker)
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=.storage
# Para AWS S3 deja S3_ENDPOINT vacío. Para R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=inspecciones
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Tamaño máximo de archivo en MB
UPLOAD_MAX_MB=10

# Zona horaria para fechas (vencimientos, "hoy" en reglas de fecha)
APP_TIMEZONE=America/Bogota
NEXT_PUBLIC_APP_TIMEZONE=America/Bogota

# Semilla: contraseña para los usuarios de prueba
SEED_DEFAULT_PASSWORD=Cambiar123*
