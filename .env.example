# ---------------------------------------------------------------------------
# Copiar a `.env` para desarrollo local. NUNCA commitear `.env` con secretos.
# ---------------------------------------------------------------------------

# development | staging | production (entorno lógico de la app; NODE_ENV lo maneja Next)
APP_ENV=development
# URL pública de la aplicación (se usa en correos, QR y enlaces de recuperación)
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://inspecciones:inspecciones@localhost:5432/inspecciones?schema=public

# Sesiones
SESSION_TTL_HOURS=12
# Secreto para firmar/derivar tokens (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Correo (SMTP). En desarrollo se usa Mailpit (docker compose) → http://localhost:8025
# Si SMTP_HOST está vacío, los correos se escriben en la consola.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Inspecciones <no-reply@inspecciones.local>"

# Almacenamiento de fotografías y documentos
#   local → carpeta LOCAL_STORAGE_DIR (desarrollo y servidores de una sola instancia)
#   s3    → Amazon S3 / Cloudflare R2 / otro S3-compatible
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
# Solo si STORAGE_DRIVER=s3 (AWS: S3_ENDPOINT vacío; R2: https://<cuenta>.r2.cloudflarestorage.com)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=inspecciones
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Tamaño máximo de archivo en MB
UPLOAD_MAX_MB=10

# Zona horaria para fechas (vencimientos, "hoy" en reglas de fecha)
APP_TIMEZONE=America/Bogota
NEXT_PUBLIC_APP_TIMEZONE=America/Bogota

# Tareas programadas (vencimientos → hallazgo crítico + plan de acción automático)
# Programador interno: se ejecuta al iniciar y cada hora (instancia única).
INTERNAL_SCHEDULER=true
# Cron externo (varias réplicas): POST /api/cron/run con "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Semilla (npm run db:seed)
#   SEED_DEMO=true  → crea datos y usuarios de PRUEBA (solo para desarrollo / demostraciones)
#   SEED_DEMO=false → instalación limpia: solo la cuenta general de Super Administrador
SEED_DEMO=false
SEED_ADMIN_EMAIL=superadmin@empresa.local
SEED_DEFAULT_PASSWORD=Cambiar123*
